# Copy this file to .env and fill in the API key for your preferred provider:

# Option 1: Google Gemini (free tier available in Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# Option 2: Groq (e.g. llama-3.3-70b-versatile)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI (e.g. gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Option 4: Local LM Studio (default http://127.0.0.1:1234/v1)
# LLM_MODEL=lmstudio/qwen3.5-4b
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
