# Copy this file to .env and fill in the API key for your preferred provider:

# Option 1: Google Gemini / Gemma via Google AI Studio (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
# Or open-weights Gemma on Google AI Studio: gemma-4-31b-it / gemma-4-26b-a4b-it

# Option 2: Groq (e.g. llama-3.3-70b-versatile)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI (e.g. gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Option 4: Local LM Studio (default http://127.0.0.1:1234/v1)
# LLM_MODEL=lmstudio/qwen3.5-4b
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
