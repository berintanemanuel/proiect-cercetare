# Copy this file to .env and fill in the API key for your preferred provider:

# Option 1: Google Gemini (free tier available in Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Option 2: Groq (e.g. llama-3.3-70b-versatile)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI (e.g. gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
